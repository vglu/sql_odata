# Настройки MS SQL Server
DB_SERVER=localhost
DB_PORT=1433
DB_NAME=master
DB_USER=sa
DB_PASSWORD=your_password
DB_ENCRYPT=false

# Настройки приложения
PORT=3000

# OData настройки
# Whitelist таблиц (разделитель: запятая). Если задан, доступны только указанные таблицы.
# ODATA_TABLES_WHITELIST=Users,Products,Orders

# Blacklist таблиц (разделитель: запятая). Если задан, исключаются указанные таблицы.
# ODATA_TABLES_BLACKLIST=SensitiveData,Passwords

# Включить Views в метаданные (true/false)
ODATA_INCLUDE_VIEWS=false

# Формат логирования (text/json)
LOG_FORMAT=text

# Swagger UI (true/false)
ENABLE_SWAGGER=true




